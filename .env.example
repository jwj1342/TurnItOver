# Copy to .env; process environment takes precedence. Never commit real keys.
# Supported providers: openai (Responses), anthropic, gemini, openai_compatible (Chat).
# Also supported: openrouter (Chat; requires a vision-capable model for the verifier).
# Set exact model IDs available to YOUR account; no implicit model selection.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
COMPATIBLE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# For OpenRouter use https://openrouter.ai/api/v1; for vLLM use its /v1 URL.
COMPATIBLE_BASE_URL=http://localhost:8000/v1

TIO_GENERATOR_PROVIDER=openai
TIO_GENERATOR_MODEL=
TIO_JUDGE_PROVIDER=anthropic
TIO_JUDGE_MODEL=
TIO_DIAGNOSIS_PROVIDER=gemini
TIO_DIAGNOSIS_MODEL=

TIO_MODEL_TIMEOUT=120
TIO_MODEL_MAX_TOKENS=4096
# Optional per-role overrides (GENERATOR/JUDGE/DIAGNOSIS):
# TIO_GENERATOR_BASE_URL=https://your-endpoint/v1
# TIO_GENERATOR_API_KEY_ENV=MY_GENERATOR_KEY
# MY_GENERATOR_KEY=
# TIO_GENERATOR_MAX_TOKENS=8192
# TIO_GENERATOR_TIMEOUT=180
# To use OpenRouter for verification:
# TIO_JUDGE_PROVIDER=openrouter
# TIO_JUDGE_MODEL=<exact model ID from OpenRouter, including organization prefix>
# To test local Qwen without any API key, use verify --local-model models/Qwen3-VL-2B-Instruct
