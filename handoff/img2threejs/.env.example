# Shared Qwen/OpenAI-compatible endpoint used by the research agents.
# For many OpenAI-compatible servers, OpenHands/LiteLLM expects a provider-prefixed
# model name such as: openai/Qwen3-VL-235B-A22B-Instruct
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=

# Per-call model limits. Leave temperature empty to let the backend choose its default.
QWEN_MAX_OUTPUT_TOKENS=8192
QWEN_TEMPERATURE=

# OpenHands agent step budgets.
CODE_AGENT_MAX_STEPS=8
VERIFIER_AGENT_MAX_STEPS=10

# Verifier observation budget. This counts active browser actions, not model turns.
VERIFIER_ACTION_BUDGET=6

# Camera action-space backend. M4/M5 currently default to V1.
VIEW_ACTION_SPACE=relative_discrete_v1
VIEW_ACTION_SPACE_CONFIG=configs/view_relative_v1.json
# To enable V2 later:
# VIEW_ACTION_SPACE=pose_grid_v2
# VIEW_ACTION_SPACE_CONFIG=configs/view_pose_grid_v2.json

# Pipeline limits.
# 首次渲染检查失败后的修复次数（0..3）；3 表示最多检查 4 个版本。
MAX_RENDER_RETRIES=3
MAX_VISUAL_REVISIONS=2
RUNS_DIR=data/runs
